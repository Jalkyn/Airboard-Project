# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# For Vercel deployment, add these in Vercel Dashboard > Settings > Environment Variables
# ============================================

# Backend API URL
# For local development: http://localhost:5000
# For production: Your backend API URL (e.g., https://your-backend.vercel.app or https://your-backend.railway.app)
VITE_API_URL=http://localhost:5000

# ============================================
# BACKEND API KEYS (for backend .env file)
# ============================================
# These are used by the Python backend, not the frontend
# Configure these in your backend deployment environment
# ============================================

# === CEREBRAS API KEYS ===
CEREBRAS_API_KEY=
CEREBRAS_GPT_OSS_120B_KEY=
CEREBRAS_QWEN_235B_KEY=
CEREBRAS_QWEN_32B_KEY=
CEREBRAS_ENDPOINT=https://api.cerebras.ai/v1/completions

# === GEMINI API KEY ===
GEMINI_API_KEY=
